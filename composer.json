{
    "name": "wilsonatb/in-app-update",
    "description": "Android Google Play Core in-app updates for NativePHP Mobile",
    "type": "nativephp-plugin",
    "license": "MIT",
    "authors": [
        {
            "name": "Wilson Tovar",
            "email": "diwdesign.wilson@gmail.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "nativephp/mobile": "^3.0"
    },
    "autoload": {
        "psr-4": {
            "Wilsonatb\\InAppUpdate\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Wilsonatb\\InAppUpdate\\InAppUpdateServiceProvider"
            ]
        },
        "nativephp": {
            "manifest": "nativephp.json"
        }
    },
    "require-dev": {
        "pestphp/pest": "^3.0"
    },
    "scripts": {
        "test": "pest"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}
