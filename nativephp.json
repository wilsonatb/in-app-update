{
    "namespace": "InAppUpdate",
    "platforms": [
        "android"
    ],
    "bridge_functions": [
        {
            "name": "InAppUpdate.CheckForUpdate",
            "android": "com.wilsonatb.plugins.in_app_update.InAppUpdateFunctions.CheckForUpdate",
            "description": "Check Google Play update availability and allowed flows"
        },
        {
            "name": "InAppUpdate.StartFlexibleUpdate",
            "android": "com.wilsonatb.plugins.in_app_update.InAppUpdateFunctions.StartFlexibleUpdate",
            "description": "Start Play Core flexible in-app update flow"
        },
        {
            "name": "InAppUpdate.StartImmediateUpdate",
            "android": "com.wilsonatb.plugins.in_app_update.InAppUpdateFunctions.StartImmediateUpdate",
            "description": "Start Play Core immediate in-app update flow"
        },
        {
            "name": "InAppUpdate.CompleteFlexibleUpdate",
            "android": "com.wilsonatb.plugins.in_app_update.InAppUpdateFunctions.CompleteFlexibleUpdate",
            "description": "Install downloaded flexible update"
        },
        {
            "name": "InAppUpdate.GetInstallStatus",
            "android": "com.wilsonatb.plugins.in_app_update.InAppUpdateFunctions.GetInstallStatus",
            "description": "Return the latest known in-app update status"
        }
    ],
    "android": {
        "min_version": 21,
        "permissions": [],
        "repositories": [],
        "dependencies": {
            "implementation": [
                "com.google.android.play:app-update:2.1.0",
                "com.google.android.play:app-update-ktx:2.1.0"
            ]
        },
        "activities": [],
        "services": [],
        "receivers": [],
        "providers": []
    },
    "ios": {
        "min_version": "15.0",
        "dependencies": {
            "swift_packages": [],
            "pods": []
        }
    },
    "assets": {
        "android": []
    },
    "events": [
        "Wilsonatb\\InAppUpdate\\Events\\InAppUpdateStateChanged",
        "Wilsonatb\\InAppUpdate\\Events\\InAppUpdateFlowCompleted"
    ],
    "hooks": {
        "copy_assets": "nativephp:in-app-update:copy-assets"
    }
}
